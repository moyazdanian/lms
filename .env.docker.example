# Copy to .env (next to docker-compose.yml) before the first `docker compose up`.
#
#   cp .env.docker.example .env
#   docker compose up -d
#
# Everything the stack needs to serve the site over HTTPS comes from the two
# domain names below; Caddy requests and renews their certificates on its own.

# --- Domain names -----------------------------------------------------------
# Point both names at the server's IP address (two DNS "A" records) before the
# first start: Caddy can only issue a certificate once the name resolves here.
#
#   example.com      -> the storefront visitors use
#   api.example.com  -> the admin panel (/admin), uploads (/storage), Google
#                       sign-in callbacks
#
# Use the exact names people will type. "www.example.com" works too, but the
# bare name and the www name are different addresses: pick one and use it.
#
# Testing without a domain: set WEB_DOMAIN=localhost and API_DOMAIN=api.localhost.
# Caddy then serves https://localhost with its own local certificate authority —
# accept the certificate warning once in the browser.
WEB_DOMAIN=localhost.com
API_DOMAIN=api.localhost.com

# --- Database ---------------------------------------------------------------
# The compose file creates this database, user and password on the first start;
# change the values before going live. After the mysql volume exists they are
# only read at creation time, so changing them later needs a matching change
# inside the server.
DB_DATABASE=lms
DB_USERNAME=lms
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root

# --- Administrator created on the very first boot ---------------------------
# Both values are required: the stack refuses to start while either is empty,
# because there is no default account and no generated password. Use an address
# you can receive mail at (password resets) and a long unique password.
# They are used only while the database is still empty; afterwards the only way
# to change them is to re-run the seeder: see documentation/docker.html.
# Fill both in. Until then `docker compose up -d` stops with an explanation.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Mail -------------------------------------------------------------------
# "log" writes messages to the API container log and sends nothing; switch to
# "smtp" and fill in a real server before going live, or neither verification
# links nor password resets reach users.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
# 587 uses STARTTLS ("smtp"); 465 uses implicit TLS ("smtps").
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="LMS"

# --- Optional ---------------------------------------------------------------
# Extra image hosts (bucket/CDN), comma separated.
NEXT_PUBLIC_MEDIA_HOSTS=

# Leave empty to let the first boot generate a key and keep it on the storage
# volume. Set it only to reuse the key of an existing installation.
APP_KEY=

# Host ports for the API and storefront. They are published on 127.0.0.1 only
# and exist for debugging on the server; the public entry point is Caddy on
# ports 80 and 443.
API_PORT=8080
WEB_PORT=3000
