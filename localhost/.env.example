[TEMPLATE]
[TEMPLATE]
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

# Hosts allowed to authenticate through Sanctum's stateful session cookie.
# Include the frontend host and port; separate multiple values with commas.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,http://app.lms.test:3000

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional comma-separated regular expressions for allowed origins.
CORS_ALLOWED_ORIGINS_PATTERNS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Use .example.com when frontend and backend are subdomains of the same domain.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------
# Private media storage (lesson videos, course previews, attachments)
# ---------------------------------------------------------------------
# Any disk defined in filesystems.php. Use "private" (local) for dev.
# For production switch to "s3" (or any S3-compatible disk) and run:
#   php artisan media:migrate-to-cloud --target=s3
LESSON_VIDEO_DISK=private
# Attachments share the video disk by default; override only if you
# want them on a different disk.
# LESSON_ATTACHMENT_DISK=private

# How authorized videos are delivered to the browser:
#   proxy  — bytes stream through the Laravel server (default, zero setup)
#   signed — browser is redirected to a time-limited signed cloud URL
#            (requires an S3-compatible disk; falls back to proxy
#            automatically when the disk cannot sign URLs)
VIDEO_SERVING_MODE=proxy
# Signed URL lifetime in minutes (VIDEO_SERVING_MODE=signed only).
VIDEO_SIGNED_URL_TTL=30

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO, DO Spaces, ...)
# ---------------------------------------------------------------------
# Keep the bucket PRIVATE: all delivery goes through authorized
# controllers or short-lived signed URLs — never use a public bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Optional custom endpoint for S3-compatible providers, e.g.
#   Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com
#   MinIO:          http://minio.local:9000
#   DO Spaces:      https://<region>.digitaloceanspaces.com
AWS_URL=
AWS_ENDPOINT=
# true for providers that use path-style URLs (MinIO and some local stacks)
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=whsec_43331dbd0d58b4c6140261373102335b049df5e6832f47eb6d3ceba9d1997854

# ---------------------------------------------------------------------
# Social Login (Google OAuth) - optional .env fallback
# ---------------------------------------------------------------------
# Recommended: configure these in the admin panel (Settings -> Google
# OAuth). These keys only matter when the panel fields are empty.
# The redirect URI registered in the Google Cloud Console must be:
#   {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"
