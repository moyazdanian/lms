# Frontend Environment Variables
# Copy this to .env.local and fill in your values

# API origin only — the /api/v1 prefix is added by the code.
# This value is compiled into the browser bundle.
NEXT_PUBLIC_API_PROD_URL=http://localhost

# Optional. Only needed when the Next.js server runs somewhere the public API
# origin does not resolve — the Docker stack, for example, sets it to
# http://api. Server Components prefer it; the browser always uses the value
# above.
# API_INTERNAL_URL=http://api

# Same origin as above: lets images served by the backend load through
# next/image. Read by next.config.mjs at startup.
NEXT_PUBLIC_API_URL=http://localhost

# Public origin of the storefront itself, e.g. https://www.example.com. Used
# for this app's sitemap, robots.txt and canonical/Open Graph URLs — the API
# origin above is a different host in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: extra comma-separated hostnames for images served straight from
# a bucket or CDN, e.g. "my-bucket.s3.eu-west-1.amazonaws.com,cdn.example.com"
NEXT_PUBLIC_MEDIA_HOSTS=
